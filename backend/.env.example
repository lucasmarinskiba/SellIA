# .env.example - Copy this to .env and fill in your values

# Database (PostgreSQL on Render, SQLite for local)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Security (REQUIRED - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-here
FERNET_SECRET=your-fernet-key-here

# Redis (Render manages this, use connection string)
REDIS_URL=redis://default:password@host:6379/0

# Environment
ENVIRONMENT=production
FRONTEND_URL=https://sellia-brain.vercel.app

# AI Providers
ANTHROPIC_API_KEY=sk-ant-your-api-key
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk-your-groq-key

# Email (get_email_sender() prefers RESEND_API_KEY over SENDGRID_API_KEY when both are set)
RESEND_API_KEY=re_your-resend-key
SENDGRID_API_KEY=SG.your-sendgrid-key

# Stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-key
