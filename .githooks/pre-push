#!/bin/sh
# SellIA · pre-push — bloquea el push si el frontend no compila/lintea.
#
# Vercel (y frontend-ci / ci.yml) fallan con exactamente estos chequeos; correrlos
# acá evita el ciclo push -> mail de "Run failed" -> arreglo. ~15-30s.
#
# Sólo corre si el push toca frontend/ (comparado contra el remoto).
# No lo saltees con --no-verify: si falla, arreglá el error que muestra.
#
# Activar (una vez):  git config core.hooksPath .githooks

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$ROOT" ] && [ -d "$ROOT/frontend/node_modules" ] || exit 0

# ¿Este push modifica algo dentro de frontend/? (rango local..remoto por ref)
TOUCHES_FRONTEND=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # borrado de rama
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    RANGE="$local_sha"                     # rama nueva: mirar todo el historial local
  else
    RANGE="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$RANGE" -- frontend/ 2>/dev/null | grep -q .; then
    TOUCHES_FRONTEND=1
  fi
done
[ "$TOUCHES_FRONTEND" = "1" ] || exit 0

cd "$ROOT/frontend" || exit 0

echo "[pre-push] frontend: tsc --noEmit ..."
# Los errores bajo .next/ son residuo de builds locales viejos; se ignoran.
TS_ERRORS="$(npx --no-install tsc --noEmit 2>&1 | grep 'error TS' | grep -v '^\.next/')"
if [ -n "$TS_ERRORS" ]; then
  echo "$TS_ERRORS"
  echo "[pre-push] ✗ errores de TypeScript — push cancelado."
  exit 1
fi

echo "[pre-push] frontend: npm run lint ..."
if ! npm run lint --silent >/dev/null 2>&1; then
  echo "[pre-push] ✗ lint falló — corré 'npm run lint' en frontend/ para ver el error. Push cancelado."
  exit 1
fi

echo "[pre-push] ✓ frontend OK"
exit 0
