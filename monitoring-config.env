# Monitoring & Observability Configuration
# Copy to Railway environment variables once URL is known

# Error Tracking (Sentry)
SENTRY_DSN=https://[YOUR_SENTRY_KEY]@sentry.io/[YOUR_PROJECT_ID]
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics
PROMETHEUS_ENABLED=true
METRICS_PORT=8001

# Performance Monitoring
APM_ENABLED=true
APM_SAMPLE_RATE=0.1

# Alerting
ALERT_WEBHOOK_SLACK=https://hooks.slack.com/services/[YOUR_SLACK_WEBHOOK]
ALERT_WEBHOOK_PAGERDUTY=https://events.pagerduty.com/v2/enqueue

# Feature Flags
DEBUG_ENDPOINTS_ENABLED=true  # Keep true for production debugging
ENABLE_DETAILED_LOGGING=true
ENABLE_METRICS_EXPORT=true

# Database Monitoring
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_QUERY_TIMEOUT=30
DB_SLOW_QUERY_THRESHOLD=1000  # ms

# API Monitoring
API_TIMEOUT_SECONDS=30
API_SLOW_THRESHOLD=2000  # ms
API_ERROR_THRESHOLD=0.5  # %

# ManyChat Webhook
MANYCHAT_WEBHOOK_TIMEOUT=10
MANYCHAT_RETRY_COUNT=3
MANYCHAT_RETRY_BACKOFF=1000  # ms

# LLM API Monitoring
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_COUNT=2
LLM_FALLBACK_ANGLES=true

# Booking Webhook
BOOKING_WEBHOOK_TIMEOUT=10
BOOKING_WEBHOOK_VERIFY_TOKEN=true

# Alert Thresholds
ALERT_ERROR_RATE_CRITICAL=5  # %
ALERT_ERROR_RATE_WARNING=1  # %
ALERT_LATENCY_CRITICAL=5000  # ms
ALERT_LATENCY_WARNING=2000  # ms
ALERT_UPTIME_THRESHOLD=99.5  # %
