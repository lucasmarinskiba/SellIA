# SellIA Celery Beat — the scheduler process that actually fires the ~68
# periodic tasks in app/tasks/celery_app.py's beat_schedule on their
# configured intervals. Without this process running, the tasks exist but
# nothing ever triggers them. See Dockerfile.celery-worker for why no
# Chromium/Playwright here and why bookworm.
#
# NOTE for future maintainers: this service's Railway "Watch Paths" setting
# was mistakenly typed as this literal filename instead of being left as a
# glob covering the app code -- meaning Railway silently SKIPS every build
# whose diff doesn't touch this exact file ("no changes detected in watch
# paths, build will skip"), even though the actual celery task code lives
# under backend/. A push that only changes backend/**/*.py will NOT deploy
# until this is fixed in the dashboard (Settings -> Watch Paths, e.g. set
# to "backend/**" or clear it) or this file itself is touched.
FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

CMD ["celery", "-A", "app.tasks.celery_app", "beat", "--loglevel=info"]
